{
  "name": "conty-challenge-views-suspeitas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/check-node.mjs && tsc -p tsconfig.build.json",
    "start": "node scripts/check-node.mjs && node dist/server.js",
    "dev": "node scripts/check-node.mjs && tsx src/server.ts",
    "dataset:generate": "node scripts/check-node.mjs && tsx scripts/generate.ts",
    "dataset:evaluate": "node scripts/check-node.mjs && tsx scripts/evaluate.ts",
    "dataset:report": "npm run dataset:generate && npm run dataset:evaluate",
    "examples:check": "node scripts/check-node.mjs && node scripts/examples.mjs",
    "readme:negative": "node scripts/check-node.mjs && node scripts/readme-negative.mjs"
  },
  "dependencies": { "@hono/node-server": "2.1.4", "hono": "4.13.13" },
  "devDependencies": { "@types/node": "22.20.5", "tsx": "4.23.15", "typescript": "5.9.3", "vitest": "5.0.3" }
}
